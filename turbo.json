{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "start": {},
    "test": { "dependsOn": ["^test"], "outputs": ["coverage/**"] },
    "test:watch": { "cache": false, "persistent": true },
    "lint": {},
    "format": {},
    "format:check": {}
  }
}
