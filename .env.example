# Used by compose.yaml. Copy to .env and fill in.

# Local database. User and name are optional (defaults: postgres / compta).
# The password must be letters and digits only: it is used inside a URL.
POSTGRES_USER=postgres
POSTGRES_DB=compta
POSTGRES_PASSWORD=

# API secrets (the API refuses to start without them).
# Generate with: openssl rand -base64 48
JWT_ACCESS_TOKEN_SECRET=
JWT_REFRESH_TOKEN_SECRET=
EMAIL_FROM=
EMAIL_API_KEY=

# Public addresses as seen from the browser. Defaults are for local use.
APP_URL=http://localhost:8080
VITE_API_URL=http://localhost:8000
